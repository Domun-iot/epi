{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "éPI",
  "version": "1.0.0",
  "identifier": "fr.epi.balance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "éPI", "width": 1180, "height": 800, "minWidth": 400, "minHeight": 450}],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {"active": true, "targets": "all", "android": {"minSdkVersion": 26}, "windows": {"nsis": {"installerIcon": "icons/icon.ico"}}, "icon": ["icons/icon.png", "icons/32.png", "icons/128.png", "icons/icon.ico"]}
}
